# Copy this file to .env and fill in real values. Never commit .env.
# scripts/reset_demo.ps1 (Windows) or scripts/reset_demo.sh creates .env from
# this file with every secret below generated, if .env doesn't exist yet.

ENVIRONMENT=local

# Used from module 3 (cost/usage governance) onward
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Upstream provider keys — never exposed to clients
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: a local Ollama server instead of a paid provider. Off unless set.
# With it set, model "local-llama3" is forwarded to Ollama as "llama3".
# Gateway in Docker:   OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Gateway on the host: OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_BASE_URL=

# "closed" = fail safe/block on internal error, "open" = fail permissive
FAIL_MODE=closed

# Used from module 4 (PII redaction) onward — encrypts RedactionVault entries
# for tokenize-mode redaction. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REDACTION_VAULT_KEY=

LOG_LEVEL=INFO

# Optional, module 6a (tactical bandit). Defaults shown; see gateway/app/config.py.
# BANDIT_ALPHA=0.5                     # exploration strength (0 = none)
# BANDIT_ALLOW_MASK_THRESHOLD=0.99     # never allow at/above this attack probability
# BANDIT_REDACT_MASK_THRESHOLD=0.999   # never redact_and_allow at/above this one
# BANDIT_REDACT_WINDOW_THRESHOLD=0.5   # redact_and_allow cuts windows at/above this
# BANDIT_REDACT_MIN_WINDOW=0.3         # ...and cuts nothing if no window reaches this
# BANDIT_DISCOUNT=0.999                # forgetting factor per update (1.0 = never forget)
# BANDIT_OUTPUT_SCAN_WEIGHT=0.2        # weight of automatic leak labels vs a human verdict
# BANDIT_REVIEW_TEAM_CAP=20            # max pending review items per team
# BANDIT_REVIEW_TTL_DAYS=7             # pending review items expire after this
# BANDIT_SPOT_CHECK_RATE=0.02          # share of decisions sent for human review

# ---- Module 10: Docker Compose deployment and demo ------------------------

# Password of the gateway's own database role (gateway_app). In Docker the
# gateway logs in with it instead of the owner account, so it can't disable
# the audit log's append-only trigger (scripts/db_setup.py). Required.
POSTGRES_APP_PASSWORD=

# Only needed on a machine without training/checkpoints/final/: a Hugging Face
# read token with access to the private model repo, used once to download the
# trained classifier (scripts/fetch_model.py).
# HF_TOKEN=

# Demo data on a fresh database: demo teams, keys and policies, a dashboard
# admin, and a few real requests so the screens aren't empty
# (scripts/seed_demo.py). Off unless true.
DEMO_SEED=true
# Demo API keys are derived from this; 16+ random characters. Required for
# DEMO_SEED and for `python -m scripts.demo`.
DEMO_SECRET=
DEMO_ADMIN_USERNAME=admin
# 12+ characters. Empty = no admin is created.
DEMO_ADMIN_PASSWORD=
# The model the demo asks. local-* models are answered by Ollama
# (OLLAMA_BASE_URL above); without it they're refused as unknown.
DEMO_MODEL=local-llama3:latest
# Local models are free, so no budget could ever run out in the demo. This
# gives them a pretend price (USD per million tokens) for the budget step.
# 0 = free, the truth. Demo only.
LOCAL_MODEL_DEMO_PRICE_PER_MILLION=0
